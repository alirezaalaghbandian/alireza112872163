# Database
DATABASE_URL=postgresql://opscore:opscore@localhost:5432/opscore
DATABASE_URL_UNPOOLED=postgresql://opscore:opscore@localhost:5432/opscore

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-minimum-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=14d
COOKIE_DOMAIN=localhost

# AI Provider (anthropic | openai)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# MinIO (S3-compatible storage for exports)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=opscore-exports

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Mailpit (dev email)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@opscore.local

# App
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
