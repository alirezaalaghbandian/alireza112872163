{
  "name": "@opscore/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests --dir src/modules",
    "test:integration": "vitest run --passWithNoTests --dir src/__tests__"
  },
  "dependencies": {
    "@opscore/db": "workspace:*",
    "@opscore/domain": "workspace:*",
    "@fastify/cookie": "^9.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@trpc/server": "^10.45.0",
    "argon2": "^0.40.0",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.0",
    "jose": "^5.6.0",
    "otpauth": "^9.3.0",
    "pino": "^9.0.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@opscore/config": "workspace:*",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
